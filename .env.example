# OmniSync environment variables. Copy to .env, fill in, and never commit .env.
# Load it with: node --env-file=.env src/index.ts
# Security values fail closed: while one is empty, the routes that need it reject
# every request and a [security] warning is printed at startup.

# HTTP port (default 3000).
PORT=

# Bearer token for POST /api/v1/inventory/adjust, /api/v1/inventory/transfer and
# /api/v1/reconciliation/trigger. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OMNISYNC_API_TOKEN=

# Webhook signing secrets for the demo stores store_shopify_us and store_woo_eu.
SHOPIFY_WEBHOOK_SECRET=
WOO_WEBHOOK_SECRET=

# Comma-separated exact origins allowed to call the API from a browser on another
# origin, e.g. https://ops.example.com. Leave empty when the dashboard is served
# by this server (same origin).
ALLOWED_ORIGINS=

# Set to true to start the server when src/index.ts is imported instead of run directly.
AUTO_START=

# Set to test to stop src/index.ts from starting the server (the test runner does this).
NODE_ENV=
